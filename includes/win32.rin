    D3D11_COMPARISON_EQUAL = 3,
    D3D11_COMPARISON_LESS_EQUAL = 4,
    D3D11_COMPARISON_GREATER = 5,
    D3D11_COMPARISON_NOT_EQUAL = 6,
    D3D11_COMPARISON_GREATER_EQUAL = 7,
    D3D11_COMPARISON_ALWAYS = 8,
}

D3D11_DEPTH_WRITE_MASK: enum[external] = {
    D3D11_DEPTH_WRITE_MASK_ZERO = 0,
    D3D11_DEPTH_WRITE_MASK_ALL = 1,
}

D3D11_STENCIL_OP: enum[external] = {
    D3D11_STENCIL_OP_KEEP = 1,
    D3D11_STENCIL_OP_ZERO = 2,
    D3D11_STENCIL_OP_REPLACE = 3,
    D3D11_STENCIL_OP_INCR_SAT = 4,
}

D3D11_CULL_MODE: enum[external] = {
    D3D11_CULL_NONE = 1,
    D3D11_CULL_FRONT = 2,
    D3D11_CULL_BACK = 3,
}

D3D11_FILL_MODE: enum[external] = {
    D3D11_FILL_WIREFRAME = 2,
    D3D11_FILL_SOLID = 3,
}

D3D11_FILTER: enum[external] = {
    D3D11_FILTER_MIN_MAG_MIP_POINT = 0,
    D3D11_FILTER_MIN_MAG_MIP_LINEAR = 21,
    D3D11_FILTER_ANISOTROPIC = 85,
    D3D11_FILTER_COMPARISON_MIN_MAG_LINEAR_MIP_POINT = 148,
}

D3D11_TEXTURE_ADDRESS_MODE: enum[external] = {
    D3D11_TEXTURE_ADDRESS_WRAP = 1,
    D3D11_TEXTURE_ADDRESS_MIRROR = 2,
    D3D11_TEXTURE_ADDRESS_CLAMP = 3,
