D3D11_CPU_ACCESS_READ: const UINT;
D3D11_RESOURCE_MISC_GENERATE_MIPS: const UINT;
D3D11_RESOURCE_MISC_TEXTURECUBE: const UINT;
D3D11_CLEAR_DEPTH: const UINT;
D3D11_CLEAR_STENCIL: const UINT;
