D3D11_SDK_VERSION: const UINT;
D3D11_COLOR_WRITE_ENABLE_ALL: const UINT8;
D3D11_DEFAULT_STENCIL_READ_MASK: const UINT8;
D3D11_DEFAULT_STENCIL_WRITE_MASK: const UINT8;
D3D11_APPEND_ALIGNED_ELEMENT: const UINT;
D3D11_FLOAT32_MAX: const f32;
DXGI_USAGE_RENDER_TARGET_OUTPUT: const UINT;
D3DCOMPILE_ENABLE_STRICTNESS: const UINT;
D3DCOMPILE_DEBUG: const UINT;
// Resolves `#include "x"` relative to the file being compiled.
D3D_COMPILE_STANDARD_FILE_INCLUDE: const *ID3DInclude;

// -- D3D11 COM objects. Only ever held behind a pointer. -----------------------

IDXGISwapChain: struct[external] = {}
ID3D11Device: struct[external] = {}
ID3D11DeviceContext: struct[external] = {}
ID3D11Resource: struct[external] = {}
ID3D11Buffer: struct[external] = {}
ID3D11Texture2D: struct[external] = {}
ID3D11RenderTargetView: struct[external] = {}
ID3D11DepthStencilView: struct[external] = {}
ID3D11ShaderResourceView: struct[external] = {}
ID3D11SamplerState: struct[external] = {}
ID3D11InputLayout: struct[external] = {}
ID3D11VertexShader: struct[external] = {}
ID3D11GeometryShader: struct[external] = {}
ID3D11PixelShader: struct[external] = {}
ID3D11RasterizerState: struct[external] = {}
ID3D11DepthStencilState: struct[external] = {}
ID3D11BlendState: struct[external] = {}
ID3D11ClassLinkage: struct[external] = {}
ID3D11ClassInstance: struct[external] = {}
ID3DBlob: struct[external] = {}
ID3DInclude: struct[external] = {}
D3D_SHADER_MACRO: struct[external] = {}

IID_ID3D11Texture2D: const IID;

// -- D3D11 descriptions. Only the fields a lesson sets. -------------------------

DXGI_SAMPLE_DESC: struct[external, no_layout_check] = {
    Count: UINT;
    Quality: UINT;
}

DXGI_MODE_DESC: struct[external, no_layout_check] = {
    Width: UINT;
    Height: UINT;
    Format: DXGI_FORMAT;
}

DXGI_SWAP_CHAIN_DESC: struct[external, no_layout_check] = {
    BufferDesc: DXGI_MODE_DESC;
    SampleDesc: DXGI_SAMPLE_DESC;
    BufferUsage: UINT;
    BufferCount: UINT;
    OutputWindow: HWND;
    Windowed: BOOL;
    SwapEffect: DXGI_SWAP_EFFECT;
}

D3D11_BUFFER_DESC: struct[external, no_layout_check] = {
    ByteWidth: UINT;
    Usage: D3D11_USAGE;
    BindFlags: UINT;
    CPUAccessFlags: UINT;
}

D3D11_SUBRESOURCE_DATA: struct[external, no_layout_check] = {
    pSysMem: *const void;
    SysMemPitch: UINT;
}

D3D11_MAPPED_SUBRESOURCE: struct[external, no_layout_check] = {
    pData: *void;
    RowPitch: UINT;
}

D3D11_TEXTURE2D_DESC: struct[external, no_layout_check] = {
    Width: UINT;
    Height: UINT;
    MipLevels: UINT;
    ArraySize: UINT;
    Format: DXGI_FORMAT;
    SampleDesc: DXGI_SAMPLE_DESC;
    Usage: D3D11_USAGE;
    BindFlags: UINT;
    CPUAccessFlags: UINT;
    MiscFlags: UINT;
}

D3D11_TEX2D_SRV: struct[external, no_layout_check] = {
    MostDetailedMip: UINT;
    MipLevels: UINT;
}

D3D11_TEX2D_ARRAY_SRV: struct[external, no_layout_check] = {
    MostDetailedMip: UINT;
    MipLevels: UINT;
    FirstArraySlice: UINT;
    ArraySize: UINT;
}

D3D11_TEXCUBE_SRV: struct[external, no_layout_check] = {
    MostDetailedMip: UINT;
    MipLevels: UINT;
}

// Texture2D, Texture2DArray and TextureCube share an anonymous union in the C
// header. Naming each directly is what C does too.
D3D11_SHADER_RESOURCE_VIEW_DESC: struct[external, no_layout_check] = {
    Format: DXGI_FORMAT;
    ViewDimension: D3D11_SRV_DIMENSION;
    Texture2D: D3D11_TEX2D_SRV;
    Texture2DArray: D3D11_TEX2D_ARRAY_SRV;
    TextureCube: D3D11_TEXCUBE_SRV;
}

D3D11_TEX2D_RTV: struct[external, no_layout_check] = {
    MipSlice: UINT;
}

D3D11_TEX2D_ARRAY_RTV: struct[external, no_layout_check] = {
    MipSlice: UINT;
    FirstArraySlice: UINT;
    ArraySize: UINT;
}

D3D11_RENDER_TARGET_VIEW_DESC: struct[external, no_layout_check] = {
    Format: DXGI_FORMAT;
    ViewDimension: D3D11_RTV_DIMENSION;
    Texture2D: D3D11_TEX2D_RTV;
    Texture2DArray: D3D11_TEX2D_ARRAY_RTV;
}

D3D11_TEX2D_DSV: struct[external, no_layout_check] = {
    MipSlice: UINT;
}

D3D11_TEX2D_ARRAY_DSV: struct[external, no_layout_check] = {
    MipSlice: UINT;
    FirstArraySlice: UINT;
    ArraySize: UINT;
}

D3D11_DEPTH_STENCIL_VIEW_DESC: struct[external, no_layout_check] = {
    Format: DXGI_FORMAT;
    ViewDimension: D3D11_DSV_DIMENSION;
    Texture2D: D3D11_TEX2D_DSV;
    Texture2DArray: D3D11_TEX2D_ARRAY_DSV;
}

D3D11_INPUT_ELEMENT_DESC: struct[external, no_layout_check] = {
    SemanticName: [*]const char;
    SemanticIndex: UINT;
    Format: DXGI_FORMAT;
    InputSlot: UINT;
    AlignedByteOffset: UINT;
    InputSlotClass: D3D11_INPUT_CLASSIFICATION;
    InstanceDataStepRate: UINT;
}

D3D11_SAMPLER_DESC: struct[external, no_layout_check] = {
    Filter: D3D11_FILTER;
    AddressU: D3D11_TEXTURE_ADDRESS_MODE;
    AddressV: D3D11_TEXTURE_ADDRESS_MODE;
    AddressW: D3D11_TEXTURE_ADDRESS_MODE;
    MaxAnisotropy: UINT;
    ComparisonFunc: D3D11_COMPARISON_FUNC;
    BorderColor: [4]FLOAT;
    MaxLOD: FLOAT;
}

D3D11_RASTERIZER_DESC: struct[external, no_layout_check] = {
    FillMode: D3D11_FILL_MODE;
    CullMode: D3D11_CULL_MODE;
    FrontCounterClockwise: BOOL;
    DepthBias: INT;
    SlopeScaledDepthBias: FLOAT;
    DepthClipEnable: BOOL;
    MultisampleEnable: BOOL;
}

D3D11_DEPTH_STENCILOP_DESC: struct[external, no_layout_check] = {
    StencilFailOp: D3D11_STENCIL_OP;
    StencilDepthFailOp: D3D11_STENCIL_OP;
    StencilPassOp: D3D11_STENCIL_OP;
    StencilFunc: D3D11_COMPARISON_FUNC;
}

D3D11_DEPTH_STENCIL_DESC: struct[external, no_layout_check] = {
    DepthEnable: BOOL;
    DepthWriteMask: D3D11_DEPTH_WRITE_MASK;
    DepthFunc: D3D11_COMPARISON_FUNC;
    StencilEnable: BOOL;
    StencilReadMask: UINT8;
    StencilWriteMask: UINT8;
    FrontFace: D3D11_DEPTH_STENCILOP_DESC;
    BackFace: D3D11_DEPTH_STENCILOP_DESC;
}

D3D11_RENDER_TARGET_BLEND_DESC: struct[external, no_layout_check] = {
    BlendEnable: BOOL;
    SrcBlend: D3D11_BLEND;
    DestBlend: D3D11_BLEND;
    BlendOp: D3D11_BLEND_OP;
    SrcBlendAlpha: D3D11_BLEND;
    DestBlendAlpha: D3D11_BLEND;
    BlendOpAlpha: D3D11_BLEND_OP;
    RenderTargetWriteMask: UINT8;
}

D3D11_BLEND_DESC: struct[external, no_layout_check] = {
    RenderTarget: [8]D3D11_RENDER_TARGET_BLEND_DESC;
}

D3D11_VIEWPORT: struct[external, no_layout_check] = {
    TopLeftX: FLOAT;
    TopLeftY: FLOAT;
    Width: FLOAT;
    Height: FLOAT;
    MinDepth: FLOAT;
    MaxDepth: FLOAT;
}

D3D11_BOX: struct[external, no_layout_check] = {
    left: UINT;
    top: UINT;
    front: UINT;
    right: UINT;
    bottom: UINT;
    back: UINT;
}

// -- D3D11 calls. COBJMACROS turns each `Interface_Method(This, ...)` into a
//    call through the vtable. ---------------------------------------------------

D3D11CreateDeviceAndSwapChain: proc[external](adapter: *void, driver: D3D_DRIVER_TYPE, software: HMODULE, flags: UINT, levels: *const D3D_FEATURE_LEVEL, level_count: UINT, sdk: UINT, desc: *const DXGI_SWAP_CHAIN_DESC, swap_chain: **IDXGISwapChain, device: **ID3D11Device, level: *D3D_FEATURE_LEVEL, context: **ID3D11DeviceContext) -> HRESULT = {}
D3DCompile: proc[external](source: *const void, size: usize, name: [*]const char, defines: *const D3D_SHADER_MACRO, include: *ID3DInclude, entry: [*]const char, target: [*]const char, flags1: UINT, flags2: UINT, code: **ID3DBlob, errors: **ID3DBlob) -> HRESULT = {}

IDXGISwapChain_GetBuffer: proc[external](This: *IDXGISwapChain, index: UINT, iid: *const IID, out: **void) -> HRESULT = {}
IDXGISwapChain_Present: proc[external](This: *IDXGISwapChain, interval: UINT, flags: UINT) -> HRESULT = {}
IDXGISwapChain_Release: proc[external](This: *IDXGISwapChain) -> ULONG = {}

ID3D10Blob_GetBufferPointer: proc[external](This: *ID3DBlob) -> *void = {}
ID3D10Blob_GetBufferSize: proc[external](This: *ID3DBlob) -> usize = {}
ID3D10Blob_Release: proc[external](This: *ID3DBlob) -> ULONG = {}

ID3D11Device_CreateBuffer: proc[external](This: *ID3D11Device, desc: *const D3D11_BUFFER_DESC, data: *const D3D11_SUBRESOURCE_DATA, out: **ID3D11Buffer) -> HRESULT = {}
ID3D11Device_CreateTexture2D: proc[external](This: *ID3D11Device, desc: *const D3D11_TEXTURE2D_DESC, data: *const D3D11_SUBRESOURCE_DATA, out: **ID3D11Texture2D) -> HRESULT = {}
ID3D11Device_CreateShaderResourceView: proc[external](This: *ID3D11Device, resource: *ID3D11Resource, desc: *const D3D11_SHADER_RESOURCE_VIEW_DESC, out: **ID3D11ShaderResourceView) -> HRESULT = {}
ID3D11Device_CreateRenderTargetView: proc[external](This: *ID3D11Device, resource: *ID3D11Resource, desc: *const D3D11_RENDER_TARGET_VIEW_DESC, out: **ID3D11RenderTargetView) -> HRESULT = {}
ID3D11Device_CreateDepthStencilView: proc[external](This: *ID3D11Device, resource: *ID3D11Resource, desc: *const D3D11_DEPTH_STENCIL_VIEW_DESC, out: **ID3D11DepthStencilView) -> HRESULT = {}
ID3D11Device_CreateSamplerState: proc[external](This: *ID3D11Device, desc: *const D3D11_SAMPLER_DESC, out: **ID3D11SamplerState) -> HRESULT = {}
ID3D11Device_CreateRasterizerState: proc[external](This: *ID3D11Device, desc: *const D3D11_RASTERIZER_DESC, out: **ID3D11RasterizerState) -> HRESULT = {}
ID3D11Device_CreateDepthStencilState: proc[external](This: *ID3D11Device, desc: *const D3D11_DEPTH_STENCIL_DESC, out: **ID3D11DepthStencilState) -> HRESULT = {}
ID3D11Device_CreateBlendState: proc[external](This: *ID3D11Device, desc: *const D3D11_BLEND_DESC, out: **ID3D11BlendState) -> HRESULT = {}
ID3D11Device_CreateInputLayout: proc[external](This: *ID3D11Device, elements: [*]const D3D11_INPUT_ELEMENT_DESC, count: UINT, code: *const void, size: usize, out: **ID3D11InputLayout) -> HRESULT = {}
ID3D11Device_CreateVertexShader: proc[external](This: *ID3D11Device, code: *const void, size: usize, linkage: *ID3D11ClassLinkage, out: **ID3D11VertexShader) -> HRESULT = {}
