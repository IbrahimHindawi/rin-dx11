D3D11_SRV_DIMENSION: enum[external] = {
    D3D11_SRV_DIMENSION_TEXTURE2D = 4,
    D3D11_SRV_DIMENSION_TEXTURE2DARRAY = 5,
    D3D11_SRV_DIMENSION_TEXTURECUBE = 9,
}

D3D11_RTV_DIMENSION: enum[external] = {
    D3D11_RTV_DIMENSION_TEXTURE2D = 4,
    D3D11_RTV_DIMENSION_TEXTURE2DARRAY = 5,
}

D3D11_DSV_DIMENSION: enum[external] = {
    D3D11_DSV_DIMENSION_TEXTURE2D = 3,
    D3D11_DSV_DIMENSION_TEXTURE2DARRAY = 4,
    D3D11_DSV_DIMENSION_TEXTURE2DMS = 5,
}

D3D11_BIND_VERTEX_BUFFER: const UINT;
D3D11_BIND_INDEX_BUFFER: const UINT;
D3D11_BIND_CONSTANT_BUFFER: const UINT;
D3D11_BIND_SHADER_RESOURCE: const UINT;
D3D11_BIND_RENDER_TARGET: const UINT;
D3D11_BIND_DEPTH_STENCIL: const UINT;
