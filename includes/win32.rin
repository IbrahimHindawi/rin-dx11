// The slice of windows.h, d3d11.h, dxgi.h, d3dcompiler.h and wincodec.h that
// the lessons touch, declared so rin can check every call. This file plays
// the part glad and GLFW's headers play for LearnOpenGL.
//
// Nothing here emits C. `struct[external]` names a type the header already
// defines, and only the fields a lesson writes are listed; field access lowers
// to C's own struct, so the offsets are always the header's. A global with no
// initializer is C-owned too: `WM_QUIT: const UINT;` lets rin say `WM_QUIT`
// and lowers to the header's macro.

#define WIN32_LEAN_AND_MEAN
#define COBJMACROS
cinclude "windows.h"
cinclude "d3d11.h"
cinclude "dxgi.h"
cinclude "d3dcompiler.h"
cinclude "wincodec.h"

// -- Scalars and handles -----------------------------------------------------

BOOL: alias[external] = i32;
BYTE: alias[external] = u8;
WORD: alias[external] = u16;
SHORT: alias[external] = i16;
DWORD: alias[external] = u32;
UINT: alias[external] = u32;
UINT8: alias[external] = u8;
INT: alias[external] = i32;
LONG: alias[external] = i32;
ULONG: alias[external] = u32;
FLOAT: alias[external] = f32;
HRESULT: alias[external] = i32;
ATOM: alias[external] = u16;
LPARAM: alias[external] = i64;
WPARAM: alias[external] = u64;
LRESULT: alias[external] = i64;
SIZE_T: alias[external] = usize;
WCHAR: alias[external] = u16;

HANDLE: alias[external] = *void;
HWND: alias[external] = *void;
HINSTANCE: alias[external] = *void;
HMODULE: alias[external] = *void;
HCURSOR: alias[external] = *void;
HICON: alias[external] = *void;
HBRUSH: alias[external] = *void;
HMENU: alias[external] = *void;

GUID: struct[external] = {}
IID: alias[external] = GUID;
CLSID: alias[external] = GUID;

// -- Windows -----------------------------------------------------------------

RECT: struct[external, no_layout_check] = {
    left: LONG;
    top: LONG;
    right: LONG;
    bottom: LONG;
}

POINT: struct[external, no_layout_check] = {
    x: LONG;
    y: LONG;
}

MSG: struct[external, no_layout_check] = {
    message: UINT;
}

LARGE_INTEGER: struct[external, no_layout_check] = {
    QuadPart: i64;
}

WNDCLASSA: struct[external, no_layout_check] = {
    // CALLBACK is part of the type: a window proc called with the wrong
    // convention corrupts the stack.
    lpfnWndProc: *proc[callconv(CALLBACK)](hwnd: HWND, msg: UINT, wparam: WPARAM, lparam: LPARAM) -> LRESULT;
    hInstance: HINSTANCE;
    hCursor: HCURSOR;
    lpszClassName: [*]const char;
}

GetModuleHandleA: proc[external](name: [*]const char) -> HMODULE = {}
GetModuleFileNameA: proc[external](module: HMODULE, out: [*]char, size: DWORD) -> DWORD = {}
GetFileAttributesA: proc[external](path: [*]const char) -> DWORD = {}
LoadCursorA: proc[external](instance: HINSTANCE, name: [*]const char) -> HCURSOR = {}
RegisterClassA: proc[external](window_class: *const WNDCLASSA) -> ATOM = {}
AdjustWindowRect: proc[external](rect: *RECT, style: DWORD, menu: BOOL) -> BOOL = {}
CreateWindowExA: proc[external](ex_style: DWORD, class_name: [*]const char, title: [*]const char, style: DWORD, x: i32, y: i32, w: i32, h: i32, parent: HWND, menu: HMENU, instance: HINSTANCE, param: *void) -> HWND = {}
DestroyWindow: proc[external](hwnd: HWND) -> BOOL = {}
ShowWindow: proc[external](hwnd: HWND, cmd: i32) -> BOOL = {}
SetWindowTextA: proc[external](hwnd: HWND, text: [*]const char) -> BOOL = {}
PeekMessageA: proc[external](msg: *MSG, hwnd: HWND, min: UINT, max: UINT, remove: UINT) -> BOOL = {}
TranslateMessage: proc[external](msg: *const MSG) -> BOOL = {}
DispatchMessageA: proc[external](msg: *const MSG) -> LRESULT = {}
DefWindowProcA: proc[external](hwnd: HWND, msg: UINT, wparam: WPARAM, lparam: LPARAM) -> LRESULT = {}
PostQuitMessage: proc[external](code: i32) -> void = {}
GetAsyncKeyState: proc[external](key: i32) -> SHORT = {}
GetForegroundWindow: proc[external]() -> HWND = {}
GetCursorPos: proc[external](point: *POINT) -> BOOL = {}
SetProcessDPIAware: proc[external]() -> BOOL = {}
QueryPerformanceFrequency: proc[external](out: *LARGE_INTEGER) -> BOOL = {}
QueryPerformanceCounter: proc[external](out: *LARGE_INTEGER) -> BOOL = {}
MultiByteToWideChar: proc[external](code_page: UINT, flags: DWORD, text: [*]const char, length: i32, out: [*]WCHAR, out_length: i32) -> i32 = {}
CoInitializeEx: proc[external](reserved: *void, flags: DWORD) -> HRESULT = {}
CoCreateInstance: proc[external](clsid: *const CLSID, outer: *void, context: DWORD, iid: *const IID, out: **void) -> HRESULT = {}

WS_OVERLAPPEDWINDOW: const DWORD;
WS_THICKFRAME: const DWORD;
WS_MAXIMIZEBOX: const DWORD;
WS_VISIBLE: const DWORD;
CW_USEDEFAULT: const i32;
SW_SHOW: const i32;
PM_REMOVE: const UINT;
IDC_ARROW: const [*]const char;
INVALID_FILE_ATTRIBUTES: const DWORD;
FILE_ATTRIBUTE_DIRECTORY: const DWORD;
CP_UTF8: const UINT;
COINIT_MULTITHREADED: const DWORD;
CLSCTX_INPROC_SERVER: const DWORD;
GENERIC_READ: const DWORD;
GENERIC_WRITE: const DWORD;

WM_QUIT: const UINT;
WM_DESTROY: const UINT;
WM_KEYDOWN: const UINT;
WM_KEYUP: const UINT;
WM_MOUSEMOVE: const UINT;
WM_RBUTTONDOWN: const UINT;
WM_RBUTTONUP: const UINT;
WM_MOUSEWHEEL: const UINT;
VK_ESCAPE: const i32;
VK_RBUTTON: const i32;
VK_TAB: const i32;
VK_SPACE: const i32;
VK_SHIFT: const i32;
VK_UP: const i32;
VK_DOWN: const i32;
VK_LEFT: const i32;
VK_RIGHT: const i32;

// -- DXGI and D3D11 enums ------------------------------------------------------

DXGI_FORMAT: enum[external] = {
    DXGI_FORMAT_UNKNOWN = 0,
    DXGI_FORMAT_R32G32B32A32_FLOAT = 2,
    DXGI_FORMAT_R32G32B32_FLOAT = 6,
    DXGI_FORMAT_R16G16B16A16_FLOAT = 10,
    DXGI_FORMAT_R32G32_FLOAT = 16,
    DXGI_FORMAT_R8G8B8A8_UNORM = 28,
    DXGI_FORMAT_R8G8B8A8_UNORM_SRGB = 29,
    DXGI_FORMAT_R16G16_FLOAT = 34,
    DXGI_FORMAT_R32_TYPELESS = 39,
    DXGI_FORMAT_D32_FLOAT = 40,
    DXGI_FORMAT_R32_FLOAT = 41,
    DXGI_FORMAT_R32_UINT = 42,
    DXGI_FORMAT_R24G8_TYPELESS = 44,
    DXGI_FORMAT_D24_UNORM_S8_UINT = 45,
    DXGI_FORMAT_R24_UNORM_X8_TYPELESS = 46,
    DXGI_FORMAT_R16_FLOAT = 54,
    DXGI_FORMAT_R8_UNORM = 61,
}

DXGI_SWAP_EFFECT: enum[external] = {
    DXGI_SWAP_EFFECT_DISCARD = 0,
    DXGI_SWAP_EFFECT_FLIP_DISCARD = 4,
}

D3D_DRIVER_TYPE: enum[external] = {
    D3D_DRIVER_TYPE_HARDWARE = 1,
}

D3D_FEATURE_LEVEL: enum[external] = {
    D3D_FEATURE_LEVEL_11_0 = 45056,
}

D3D11_USAGE: enum[external] = {
    D3D11_USAGE_DEFAULT = 0,
    D3D11_USAGE_IMMUTABLE = 1,
    D3D11_USAGE_DYNAMIC = 2,
    D3D11_USAGE_STAGING = 3,
}

D3D11_MAP: enum[external] = {
    D3D11_MAP_READ = 1,
    D3D11_MAP_WRITE_DISCARD = 4,
}

D3D11_INPUT_CLASSIFICATION: enum[external] = {
    D3D11_INPUT_PER_VERTEX_DATA = 0,
    D3D11_INPUT_PER_INSTANCE_DATA = 1,
}

D3D11_PRIMITIVE_TOPOLOGY: enum[external] = {
    D3D11_PRIMITIVE_TOPOLOGY_POINTLIST = 1,
    D3D11_PRIMITIVE_TOPOLOGY_LINELIST = 2,
    D3D11_PRIMITIVE_TOPOLOGY_TRIANGLELIST = 4,
    D3D11_PRIMITIVE_TOPOLOGY_TRIANGLESTRIP = 5,
