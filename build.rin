    "src/4.advanced_d3d11/8.advanced_hlsl/advanced_hlsl.rin",
    "src/4.advanced_d3d11/9.1.geometry_shader/geometry_shader.rin",
    "src/4.advanced_d3d11/10.1.instancing/instancing.rin",
    "src/4.advanced_d3d11/11.1.anti_aliasing/anti_aliasing.rin",
    "src/5.advanced_lighting/1.advanced_lighting/advanced_lighting.rin",
