// How the lessons are built. Read by `rin build`, not executed.
//
// Every lesson is its own program, named after its file.
build_name:      [*]const char = "rin-dx11";
build_dir:       [*]const char = "build";
build_generator: [*]const char = "Ninja";
build_compiler:  [*]const char = "clang-cl";
build_type:      [*]const char = "Debug";

build_entries: [38][*]const char = {
    "src/1.getting_started/1.1.hello_window/hello_window.rin",
    "src/1.getting_started/2.1.hello_triangle/hello_triangle.rin",
    "src/1.getting_started/3.1.shaders/shaders.rin",
